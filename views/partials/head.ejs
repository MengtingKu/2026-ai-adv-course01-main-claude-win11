<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — 花漾生活 BLOOM' : '花漾生活 BLOOM' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Inter+Tight:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/output.css">
  <script>
    // Motion bootstrap：在首次繪製前啟用動效 class，並提早捕捉圖片 load（事件不冒泡，需 capture）
    (function () {
      var root = document.documentElement;
      root.classList.add('js-motion');
      try {
        if (!sessionStorage.getItem('m-seen')) { root.classList.add('m-first'); sessionStorage.setItem('m-seen', '1'); }
      } catch (e) {}
      function markLoaded(e) { if (e.target && e.target.tagName === 'IMG') e.target.classList.add('is-loaded'); }
      document.addEventListener('load', markLoaded, true);
      document.addEventListener('error', markLoaded, true);
    })();
  </script>
</head>
