<%
  const adminNav = [
    { href: '/admin/products', label: '商品管理', en: 'Catalogue',
      icon: '<path d="M21 8 12 3 3 8v8l9 5 9-5V8Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>' },
    { href: '/admin/orders', label: '訂單管理', en: 'Orders',
      icon: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6M9 16h3"/>' },
  ];
  const isActive = (href) => typeof currentPath !== 'undefined' && currentPath === href;
%>

<!-- ══ Desktop sidebar ══ -->
<aside class="hidden md:flex sticky top-0 h-screen w-64 shrink-0 flex-col bg-bg-dark text-white">
  <a href="/admin/products" class="flex flex-col gap-1 px-7 h-[72px] justify-center border-b border-white/10">
    <span class="font-display text-[22px] font-semibold leading-none tracking-tight">花漾生活</span>
    <span class="font-ui text-[9px] font-medium tracking-[3px] text-white/60 uppercase">Bloom · Atelier Admin</span>
  </a>

  <nav class="flex-1 px-4 py-8" aria-label="後台導覽">
    <p class="px-3 mb-3 font-ui text-overline text-white/60">Manage</p>
    <% adminNav.forEach((item, i) => { const active = isActive(item.href); %>
      <a href="<%= item.href %>" <%- active ? 'aria-current="page"' : '' %>
         class="group relative flex items-center gap-3 px-3 h-12 mb-1 font-ui text-[14px] transition-colors duration-200
                <%= active ? 'bg-white/[0.07] text-white' : 'text-white/70 hover:text-white hover:bg-white/[0.04]' %>">
        <span class="absolute left-0 top-2 bottom-2 w-[2px] bg-cherry origin-top transition-transform duration-300 <%= active ? 'scale-y-100' : 'scale-y-0 group-hover:scale-y-50' %>" aria-hidden="true"></span>
        <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- item.icon %></svg>
        <span class="flex-1"><%= item.label %></span>
        <span class="font-ui text-[10px] tracking-[1.5px] uppercase text-white/60"><%= item.en %></span>
      </a>
    <% }) %>
  </nav>

  <div class="px-4 pb-6 border-t border-white/10 pt-5">
    <div class="flex items-center gap-3 px-3 mb-4">
      <span data-admin-initial class="w-9 h-9 shrink-0 flex items-center justify-center bg-white/10 font-display text-[18px]">A</span>
      <div class="min-w-0">
        <p data-admin-name class="font-ui text-[13px] text-white truncate"></p>
        <p class="font-ui text-[11px] text-white/60">管理員</p>
      </div>
    </div>
    <a href="/" class="flex items-center justify-between px-3 h-10 font-ui text-[13px] text-white/70 hover:text-white transition-colors">
      返回前台 <span class="m-arrow" aria-hidden="true">→</span>
    </a>
    <button type="button" onclick="Auth.logout()" class="w-full flex items-center px-3 h-10 font-ui text-[13px] text-white/70 hover:text-white transition-colors">
      登出
    </button>
  </div>
</aside>

<!-- ══ Mobile bottom tab bar（design system cmp/mobile-tabbar） ══ -->
<nav class="md:hidden fixed inset-x-0 bottom-0 z-40 bg-bg-paper border-t border-line-soft pb-[env(safe-area-inset-bottom)]" aria-label="後台導覽">
  <div class="grid grid-cols-3 h-16">
    <% adminNav.forEach(item => { const active = isActive(item.href); %>
      <a href="<%= item.href %>" <%- active ? 'aria-current="page"' : '' %>
         class="relative flex flex-col items-center justify-center gap-1 font-ui text-[11px] font-medium <%= active ? 'text-ink-900' : 'text-ink-500' %>">
        <% if (active) { %><span class="absolute top-0 left-1/2 -translate-x-1/2 w-8 h-[2px] bg-cherry" aria-hidden="true"></span><% } %>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- item.icon %></svg>
        <%= item.label %>
      </a>
    <% }) %>
    <a href="/" class="flex flex-col items-center justify-center gap-1 font-ui text-[11px] font-medium text-ink-500">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9v12h14V9"/></svg>
      返回前台
    </a>
  </div>
</nav>
