<div id="app" v-cloak data-product-id="<%= productId %>" class="max-w-screen-xl mx-auto px-4 md:px-12 py-8 md:py-16">

  <!-- Loading：與商品版型同比例的 skeleton -->
  <div v-if="loading" class="flex flex-col md:flex-row gap-6 md:gap-14" aria-busy="true" aria-label="商品載入中">
    <div class="w-full md:w-[55%] md:shrink-0">
      <div class="m-skeleton aspect-[4/5]"></div>
    </div>
    <div class="flex flex-col justify-center flex-1 pt-2 space-y-5">
      <div class="m-skeleton h-3 w-24"></div>
      <div class="m-skeleton h-10 md:h-14 w-4/5"></div>
      <div class="m-skeleton h-7 w-32"></div>
      <div class="m-skeleton h-20 w-full"></div>
      <div class="m-skeleton h-12 md:h-14 w-full"></div>
    </div>
  </div>

  <!-- Not found -->
  <div v-else-if="notFound" class="flex flex-col items-center py-24 text-center">
    <span class="font-display text-[80px] font-light text-ink-500 leading-none mb-4">404</span>
    <p class="font-ui text-[15px] text-ink-600 mb-6">找不到此商品</p>
    <a href="/" class="m-fill m-fill-ink font-ui text-[13px] border border-ink-900 text-ink-900 px-6 h-10 flex items-center hover:text-white transition-all duration-150">
      回到首頁
    </a>
  </div>

  <!-- Product -->
  <div v-else-if="product" class="flex flex-col md:flex-row gap-6 md:gap-14">

    <!-- Left: Image -->
    <div class="w-full md:w-[55%] md:shrink-0">
      <div class="m-curtain m-shine group overflow-hidden aspect-[4/5] bg-bg-raised">
        <img
          :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=800&q=80'"
          :alt="product.name"
          fetchpriority="high"
          class="w-full h-full object-cover group-hover:scale-[1.03]"
        />
      </div>
    </div>

    <!-- Right: Info -->
    <div class="m-stagger flex flex-col justify-center flex-1 pt-2" style="--m-base:240ms">
      <!-- Breadcrumb -->
      <p class="font-ui text-overline text-ink-500 mb-5 md:mb-6">
        <a href="/" class="hover:text-ink-900 transition-colors">首頁</a>
        <span class="mx-3 text-line-soft">/</span>
        商品詳情
      </p>

      <!-- Name -->
      <h1 class="font-display text-[32px] md:text-[52px] font-light text-ink-900 leading-[1.05] mb-3">
        {{ product.name }}
      </h1>

      <!-- Cherry seam -->
      <div class="w-10 h-[2px] bg-cherry mb-4 md:mb-5"></div>

      <!-- Price -->
      <p class="font-ui text-[22px] md:text-[28px] font-medium text-cherry mb-4">
        NT$ {{ product.price.toLocaleString() }}
      </p>

      <!-- Stock badge -->
      <div class="mb-5 md:mb-6">
        <span v-if="product.stock > 0" class="font-ui text-[12px] text-success-ink border border-success/30 bg-success/5 px-3 py-1">
          尚有 {{ product.stock }} 件
        </span>
        <span v-else class="font-ui text-[12px] text-error-ink border border-error/30 bg-error/5 px-3 py-1">
          已售完
        </span>
      </div>

      <!-- Description -->
      <p class="font-ui text-[14px] md:text-[15px] leading-[1.75] text-ink-600 mb-6 md:mb-8">
        {{ product.description }}
      </p>

      <!-- Separator -->
      <div class="h-px bg-line-soft mb-5 md:mb-6"></div>

      <!-- Quantity -->
      <div class="flex items-center gap-6 mb-4 md:mb-5">
        <span class="font-ui text-[12px] tracking-[1px] text-ink-500 uppercase w-12">數量</span>
        <div class="flex items-center border border-line-strong">
          <button @click="decrease" class="m-fill m-fill-ink w-10 h-10 flex items-center justify-center text-ink-600 hover:text-white transition-colors duration-150">−</button>
          <span class="w-12 h-10 flex items-center justify-center font-ui text-[14px] text-ink-900 border-x border-line-soft overflow-hidden"><span :key="quantity" class="m-tick inline-block">{{ quantity }}</span></span>
          <button @click="increase" class="m-fill m-fill-ink w-10 h-10 flex items-center justify-center text-ink-600 hover:text-white transition-colors duration-150">+</button>
        </div>
      </div>

      <!-- Add to cart -->
      <button
        @click="addToCart"
        :disabled="adding || product.stock <= 0"
        class="m-fill w-full h-12 md:h-14 font-ui text-[14px] font-medium tracking-[1px] bg-cherry text-white transition-colors duration-150 disabled:opacity-40 disabled:cursor-not-allowed mb-3"
      >
        {{ product.stock <= 0 ? '已售完' : '加入購物車' }}
      </button>

      <!-- Ghost secondary action -->
      <a href="/cart" class="w-full h-11 md:h-12 font-ui text-[13px] text-ink-600 border border-line-soft flex items-center justify-center hover:border-ink-900 hover:text-ink-900 transition-all duration-150">
        前往購物車
      </a>

      <!-- Purchase notes -->
      <div class="mt-6 md:mt-8 border-t border-line-soft pt-5 md:pt-6 space-y-3">
        <% const notes = [
          {icon:'↻', text:'花材依季節供應，實際花束可能略有差異'},
          {icon:'◆', text:'台北市區可享當日配送服務'},
          {icon:'✦', text:'宅配滿 NT$ ' + shippingRules.freeShippingThreshold.toLocaleString() + ' 免基本運費（超商取貨 NT$ ' + shippingRules.convenienceStoreFee + '）'},
        ] %>
        <% notes.forEach(n => { %>
          <div class="flex items-start gap-3">
            <span class="font-ui text-[10px] text-cherry mt-1 shrink-0"><%= n.icon %></span>
            <span class="font-ui text-[13px] text-ink-500 leading-relaxed"><%= n.text %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

</div>
