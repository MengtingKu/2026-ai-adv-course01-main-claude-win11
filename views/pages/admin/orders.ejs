<div id="app" v-cloak>

  <!-- Page head -->
  <div class="mb-6 md:mb-8">
    <p class="font-ui text-overline text-ink-500 mb-2">Orders</p>
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <h1 class="font-display text-[34px] md:text-[44px] font-light leading-none">訂單管理</h1>
        <p class="font-ui text-[13px] text-ink-600 mt-3" v-if="!loading">
          共 <span class="tabular-nums font-medium text-ink-900">{{ pagination.total }}</span> 筆訂單
        </p>
      </div>

      <!-- Status filter chips（手機可橫向捲動） -->
      <div class="-mx-4 px-4 sm:mx-0 sm:px-0 overflow-x-auto" role="group" aria-label="依狀態篩選">
        <div class="flex gap-2 w-max">
          <button
            v-for="f in filters"
            :key="f.value"
            type="button"
            @click="statusFilter = f.value"
            :aria-pressed="statusFilter === f.value"
            class="h-10 px-4 font-ui text-[13px] border rounded-full whitespace-nowrap transition-colors"
            :class="statusFilter === f.value ? 'bg-ink-900 border-ink-900 text-white' : 'bg-bg-paper border-line-soft text-ink-600 hover:border-ink-900 hover:text-ink-900'"
          >{{ f.label }}</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Loading skeleton -->
  <div v-if="loading" class="bg-bg-paper border border-line-soft divide-y divide-line-soft" aria-busy="true" aria-label="訂單載入中">
    <div v-for="n in 6" :key="n" class="flex items-center justify-between gap-4 p-4">
      <div class="flex-1 space-y-2">
        <div class="m-skeleton h-3.5 w-1/3"></div>
        <div class="m-skeleton h-3 w-1/5"></div>
      </div>
      <div class="m-skeleton h-6 w-16"></div>
    </div>
  </div>

  <template v-else>
    <div v-if="orders.length === 0" class="bg-bg-paper border border-line-soft py-20 text-center">
      <p class="font-display text-[32px] font-light text-ink-600 mb-2">沒有訂單</p>
      <p class="font-ui text-[13px] text-ink-500">{{ statusFilter ? '此狀態目前沒有訂單' : '尚未有任何訂單' }}</p>
    </div>

    <template v-else>
      <!-- Desktop table -->
      <div class="hidden min-[1200px]:block bg-bg-paper border border-line-soft">
        <table class="w-full font-ui text-[14px]">
          <caption class="sr-only">訂單列表，按 Enter 開啟明細</caption>
          <thead>
            <tr class="border-b border-line-soft text-ink-500">
              <th scope="col" class="text-left font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">訂單編號</th>
              <th scope="col" class="text-left font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">收件人</th>
              <th scope="col" class="text-left font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">配送</th>
              <th scope="col" class="text-right font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">金額</th>
              <th scope="col" class="text-left font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">狀態</th>
              <th scope="col" class="text-right font-medium text-[11px] tracking-[1.5px] uppercase px-5 h-11">日期</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line-soft">
            <tr
              v-for="(order, i) in orders"
              :key="order.id"
              class="m-row m-enter cursor-pointer"
              :style="{ '--i': Math.min(i, 8) }"
              tabindex="0"
              @click="viewDetail(order.id)"
              @keydown.enter.prevent="viewDetail(order.id)"
            >
              <td class="px-5 h-14 font-medium text-ink-900 tabular-nums">{{ order.order_no }}</td>
              <td class="px-5 h-14 text-ink-600">{{ order.recipient_name }}</td>
              <td class="px-5 h-14 text-ink-600">{{ shippingLabel(order.shipping_method) }}</td>
              <td class="px-5 h-14 text-right tabular-nums text-ink-900">NT$ {{ order.total_amount.toLocaleString() }}</td>
              <td class="px-5 h-14">
                <span class="inline-flex items-center gap-1.5 text-[12px] font-medium px-2 py-0.5 border" :class="status(order.status).cls">
                  <span class="w-1.5 h-1.5 rounded-full" :class="status(order.status).dot" aria-hidden="true"></span>
                  {{ status(order.status).label }}
                </span>
              </td>
              <td class="px-5 h-14 text-right text-ink-600 tabular-nums">{{ formatDate(order.created_at) }}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile cards -->
      <ul class="min-[1200px]:hidden grid gap-3 sm:grid-cols-2">
        <li v-for="(order, i) in orders" :key="order.id" class="m-enter" :style="{ '--i': Math.min(i, 8) }">
          <button type="button" @click="viewDetail(order.id)" class="w-full h-full text-left bg-bg-paper border border-line-soft p-4 active:bg-bg-raised font-ui">
            <div class="flex items-start justify-between gap-3 mb-3">
              <p class="text-[14px] font-medium text-ink-900 tabular-nums break-all">{{ order.order_no }}</p>
              <span class="shrink-0 inline-flex items-center gap-1.5 text-[12px] font-medium px-2 py-0.5 border" :class="status(order.status).cls">
                <span class="w-1.5 h-1.5 rounded-full" :class="status(order.status).dot" aria-hidden="true"></span>
                {{ status(order.status).label }}
              </span>
            </div>
            <div class="flex items-end justify-between gap-3">
              <div class="text-[13px] text-ink-600 leading-relaxed">
                <p>{{ order.recipient_name }}</p>
                <p class="tabular-nums">{{ formatDate(order.created_at) }}</p>
              </div>
              <p class="text-[16px] font-medium text-ink-900 tabular-nums">NT$ {{ order.total_amount.toLocaleString() }}</p>
            </div>
          </button>
        </li>
      </ul>

      <!-- Pagination -->
      <nav v-if="pagination.totalPages > 1" class="flex flex-wrap justify-center gap-2 mt-8" aria-label="分頁">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          type="button"
          @click="loadOrders(p)"
          :aria-current="p === pagination.page ? 'page' : null"
          class="w-11 h-11 font-ui text-[13px] tabular-nums border transition-colors"
          :class="p === pagination.page ? 'bg-ink-900 border-ink-900 text-white' : 'border-line-soft text-ink-600 hover:border-ink-900 hover:text-ink-900 bg-bg-paper'"
        >{{ p }}</button>
      </nav>
    </template>
  </template>

  <!-- ══ Order detail drawer ══ -->
  <transition name="m-drawer">
    <div v-if="detailVisible" class="fixed inset-0 z-50" role="dialog" aria-modal="true" aria-labelledby="order-drawer-title">
      <div class="absolute inset-0 bg-ink-900/50" @click="detailVisible = false"></div>
      <div class="m-drawer-panel absolute right-0 top-0 h-full w-full sm:max-w-xl bg-bg-paper flex flex-col shadow-[0_8px_40px_rgba(26,25,23,.18)] font-ui">
        <div class="flex items-center justify-between px-5 sm:px-7 h-16 border-b border-line-soft shrink-0">
          <div>
            <p class="font-ui text-overline text-ink-500">Order</p>
            <h2 id="order-drawer-title" class="font-display text-[24px] font-light leading-tight">訂單詳情</h2>
          </div>
          <button type="button" @click="detailVisible = false" class="w-11 h-11 -mr-3 flex items-center justify-center text-ink-600 hover:text-ink-900" aria-label="關閉">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="flex-1 overflow-y-auto px-5 sm:px-7 py-6">
          <div v-if="detailLoading" class="space-y-4" aria-busy="true">
            <div class="m-skeleton h-5 w-1/2"></div>
            <div class="m-skeleton h-24 w-full"></div>
            <div class="m-skeleton h-40 w-full"></div>
          </div>

          <template v-else-if="detailOrder">
            <!-- Summary -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
              <p class="text-[15px] font-medium text-ink-900 tabular-nums break-all">{{ detailOrder.order_no }}</p>
              <span class="inline-flex items-center gap-1.5 text-[12px] font-medium px-2 py-0.5 border" :class="status(detailOrder.status).cls">
                <span class="w-1.5 h-1.5 rounded-full" :class="status(detailOrder.status).dot" aria-hidden="true"></span>
                {{ status(detailOrder.status).label }}
              </span>
            </div>

            <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-[14px] pb-6 border-b border-line-soft">
              <div>
                <dt class="text-[12px] text-ink-500 mb-1">買家</dt>
                <dd class="text-ink-900">{{ detailOrder.user?.name }}</dd>
                <dd class="text-ink-600 text-[13px] break-all">{{ detailOrder.user?.email }}</dd>
              </div>
              <div>
                <dt class="text-[12px] text-ink-500 mb-1">下單日期</dt>
                <dd class="text-ink-900 tabular-nums">{{ formatDate(detailOrder.created_at, true) }}</dd>
                <dd v-if="detailOrder.paid_at" class="text-ink-600 text-[13px] tabular-nums">付款 {{ formatDate(detailOrder.paid_at, true) }}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-[12px] text-ink-500 mb-1">收件資訊</dt>
                <dd class="text-ink-900">{{ detailOrder.recipient_name }}</dd>
                <dd class="text-ink-600 text-[13px] break-all">{{ detailOrder.recipient_email }}</dd>
                <dd class="text-ink-600 text-[13px]">{{ detailOrder.recipient_address }}</dd>
              </div>
              <div class="sm:col-span-2">
                <dt class="text-[12px] text-ink-500 mb-1">配送方式</dt>
                <dd class="text-ink-900 flex flex-wrap items-center gap-2">
                  {{ shippingLabel(detailOrder.shipping_method) }}
                  <span v-if="detailOrder.is_urgent" class="text-[11px] px-1.5 py-0.5 border text-warning-ink bg-warning/10 border-warning/30">當日急件</span>
                  <span v-if="detailOrder.is_remote_area" class="text-[11px] px-1.5 py-0.5 border text-ink-600 border-line-soft">偏遠地區</span>
                </dd>
              </div>
            </dl>

            <!-- Items -->
            <h3 class="font-ui text-overline text-ink-500 mt-6 mb-3">商品明細</h3>
            <ul class="divide-y divide-line-soft border-y border-line-soft">
              <li v-for="item in detailOrder.items" :key="item.id" class="flex items-start justify-between gap-4 py-3 text-[14px]">
                <div class="min-w-0">
                  <p class="text-ink-900">{{ item.product_name }}</p>
                  <p class="text-[13px] text-ink-600 tabular-nums">NT$ {{ item.product_price.toLocaleString() }} × {{ item.quantity }}</p>
                </div>
                <p class="shrink-0 text-ink-900 tabular-nums">NT$ {{ (item.product_price * item.quantity).toLocaleString() }}</p>
              </li>
            </ul>

            <dl class="mt-4 space-y-2 text-[14px]">
              <div v-if="detailOrder.subtotal != null" class="flex justify-between text-ink-600">
                <dt>商品小計</dt><dd class="tabular-nums">NT$ {{ detailOrder.subtotal.toLocaleString() }}</dd>
              </div>
              <div class="flex justify-between text-ink-600">
                <dt>運費</dt><dd class="tabular-nums">{{ detailOrder.shipping_fee ? 'NT$ ' + detailOrder.shipping_fee.toLocaleString() : '免運' }}</dd>
              </div>
              <div class="flex justify-between items-baseline pt-3 border-t border-line-soft">
                <dt class="font-medium text-ink-900">總計</dt>
                <dd class="font-display text-[26px] text-ink-900 tabular-nums">NT$ {{ detailOrder.total_amount.toLocaleString() }}</dd>
              </div>
            </dl>
          </template>
        </div>
      </div>
    </div>
  </transition>
</div>
