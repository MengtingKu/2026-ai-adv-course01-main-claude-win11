<div id="app" class="max-w-screen-xl mx-auto px-4 md:px-12 py-8 md:py-16">

  <!-- Page header -->
  <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-1 mb-6 md:mb-10">
    <p class="font-ui text-overline text-ink-400">結帳</p>
    <h1 class="font-display text-[28px] md:text-[52px] font-light text-ink-900 leading-none">Checkout</h1>
  </div>

  <!-- Loading -->
  <div v-if="loading" class="flex justify-center py-24">
    <div class="w-6 h-6 border-2 border-ink-900 border-t-transparent rounded-full animate-spin"></div>
  </div>

  <div v-else class="flex flex-col lg:flex-row gap-10 items-start">

    <!-- Left: Recipient form -->
    <div class="flex-1 min-w-0">
      <div class="border border-line-soft bg-bg-paper p-5 md:p-8">
        <h2 class="font-ui text-overline text-ink-400 mb-6">收件資訊</h2>

        <div class="space-y-6">
          <!-- Name -->
          <div>
            <label class="block font-ui text-[12px] font-medium text-ink-900 mb-2">收件人姓名</label>
            <input
              v-model="form.recipientName"
              type="text"
              placeholder="請輸入收件人姓名"
              class="w-full border border-line-soft bg-white px-4 h-11 font-ui text-[14px] text-ink-900 placeholder:text-ink-400 focus:outline-none focus:border-ink-900 transition-colors"
              :class="{ 'border-error': errors.recipientName }"
            />
            <p v-if="errors.recipientName" class="font-ui text-[12px] text-error mt-1.5">{{ errors.recipientName }}</p>
          </div>

          <!-- Email -->
          <div>
            <label class="block font-ui text-[12px] font-medium text-ink-900 mb-2">Email</label>
            <input
              v-model="form.recipientEmail"
              type="email"
              placeholder="請輸入 Email"
              class="w-full border border-line-soft bg-white px-4 h-11 font-ui text-[14px] text-ink-900 placeholder:text-ink-400 focus:outline-none focus:border-ink-900 transition-colors"
              :class="{ 'border-error': errors.recipientEmail }"
            />
            <p v-if="errors.recipientEmail" class="font-ui text-[12px] text-error mt-1.5">{{ errors.recipientEmail }}</p>
          </div>

          <!-- Address -->
          <div>
            <label class="block font-ui text-[12px] font-medium text-ink-900 mb-2">收件地址</label>
            <input
              v-model="form.recipientAddress"
              type="text"
              placeholder="請輸入收件地址"
              class="w-full border border-line-soft bg-white px-4 h-11 font-ui text-[14px] text-ink-900 placeholder:text-ink-400 focus:outline-none focus:border-ink-900 transition-colors"
              :class="{ 'border-error': errors.recipientAddress }"
            />
            <p v-if="errors.recipientAddress" class="font-ui text-[12px] text-error mt-1.5">{{ errors.recipientAddress }}</p>
          </div>
        </div>
      </div>

      <div class="border border-line-soft bg-bg-paper p-5 md:p-8 mt-6">
        <h2 class="font-ui text-overline text-ink-400 mb-6">配送方式</h2>

        <div class="space-y-3 mb-6">
          <label class="flex items-center justify-between gap-4 border border-line-soft bg-white px-4 h-12 cursor-pointer"
                 :class="{ 'border-ink-900': form.shippingMethod === 'home_delivery' }">
            <span class="flex items-center gap-3">
              <input type="radio" value="home_delivery" v-model="form.shippingMethod" class="accent-cherry" />
              <span class="font-ui text-[14px] text-ink-900">宅配到府</span>
            </span>
            <span class="font-ui text-[12px] text-ink-600">NT$ 120・滿 NT$ 1,500 免運</span>
          </label>
          <label class="flex items-center justify-between gap-4 border border-line-soft bg-white px-4 h-12 cursor-pointer"
                 :class="{ 'border-ink-900': form.shippingMethod === 'convenience_store' }">
            <span class="flex items-center gap-3">
              <input type="radio" value="convenience_store" v-model="form.shippingMethod" class="accent-cherry" />
              <span class="font-ui text-[14px] text-ink-900">超商取貨</span>
            </span>
            <span class="font-ui text-[12px] text-ink-600">NT$ 60</span>
          </label>
        </div>

        <div class="space-y-3">
          <label class="flex items-center justify-between gap-4 cursor-pointer">
            <span class="flex items-center gap-3">
              <input type="checkbox" v-model="form.isRemoteArea" class="accent-cherry" />
              <span class="font-ui text-[14px] text-ink-900">偏遠地區</span>
            </span>
            <span class="font-ui text-[12px] text-ink-600">+ NT$ 200</span>
          </label>
          <label class="flex items-center justify-between gap-4 cursor-pointer">
            <span class="flex items-center gap-3">
              <input type="checkbox" v-model="form.isUrgent" class="accent-cherry" />
              <span class="font-ui text-[14px] text-ink-900">當日急件</span>
            </span>
            <span class="font-ui text-[12px] text-ink-600">+ NT$ 250</span>
          </label>
        </div>
      </div>
    </div>

    <!-- Right: Summary -->
    <div class="lg:w-80 shrink-0">
      <div class="border border-line-soft bg-bg-paper p-5 md:p-6 sticky top-24">
        <h2 class="font-ui text-overline text-ink-400 mb-5">訂單摘要</h2>

        <!-- Items -->
        <div class="space-y-3 mb-5">
          <div v-for="item in cartItems" :key="item.id"
               class="flex items-center justify-between">
            <span class="font-ui text-[13px] text-ink-600 truncate mr-4">{{ item.product.name }} ×{{ item.quantity }}</span>
            <span class="font-ui text-[13px] text-ink-900 shrink-0">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</span>
          </div>
        </div>

        <!-- Totals -->
        <div class="border-t border-line-soft pt-4 space-y-3 mb-4">
          <div class="flex justify-between">
            <span class="font-ui text-[13px] text-ink-600">商品小計</span>
            <span class="font-ui text-[13px] text-ink-900">NT$ {{ cartTotal.toLocaleString() }}</span>
          </div>
          <template v-if="quote">
            <div class="flex justify-between">
              <span class="font-ui text-[13px] text-ink-600">{{ quote.shipping.method === 'home_delivery' ? '宅配運費' : '超商取貨' }}</span>
              <span class="font-ui text-[13px] text-ink-900">{{ quote.shipping.freeShippingApplied ? '免運' : 'NT$ ' + quote.shipping.baseFee.toLocaleString() }}</span>
            </div>
            <div v-if="quote.shipping.remoteAreaSurcharge" class="flex justify-between">
              <span class="font-ui text-[13px] text-ink-600">偏遠地區附加費</span>
              <span class="font-ui text-[13px] text-ink-900">NT$ {{ quote.shipping.remoteAreaSurcharge.toLocaleString() }}</span>
            </div>
            <div v-if="quote.shipping.urgentSurcharge" class="flex justify-between">
              <span class="font-ui text-[13px] text-ink-600">當日急件附加費</span>
              <span class="font-ui text-[13px] text-ink-900">NT$ {{ quote.shipping.urgentSurcharge.toLocaleString() }}</span>
            </div>
          </template>
        </div>

        <div class="border-t border-line-soft pt-4 flex justify-between items-center mb-6">
          <span class="font-ui text-[14px] font-medium text-ink-900">總計</span>
          <span class="font-display text-[24px] font-medium text-cherry">
            NT$ {{ (quote ? quote.total_amount : cartTotal).toLocaleString() }}
          </span>
        </div>

        <button
          @click="submitOrder"
          :disabled="submitting"
          class="w-full h-12 font-ui text-[13px] font-medium tracking-[1px] bg-cherry text-white hover:bg-cherry-press transition-colors duration-150 disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {{ submitting ? '處理中...' : '確認送出訂單' }}
        </button>
      </div>
    </div>

  </div>
</div>
